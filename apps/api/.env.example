# Copy this file to apps/api/.env and fill the values. Do not commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=

# Firebase web app (Project settings → Your apps). The API key is the public web key.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Google accounts that should be operators, comma-separated.
ADMIN_EMAILS=
